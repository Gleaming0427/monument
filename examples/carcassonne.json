   "id": "romain",
   "when": "Late 3rd century",
   "title": "The Gallo-Roman wall",
   "text": "A first enclosure, strengthened with towers, closes off the plateau. It will become the base of the inner wall.",
   "source": "https://www.monuments-nationaux.fr/var/cmn_inter/storage/original/application/04c4ac49032d69b1d28487e75f935011.pdf",
   "moments": [
    {
     "at": 0.5,
     "tag": "Technique",
     "title": "A wall reused",
     "anchor": [
      88,
      9,
      0
     ],
     "source": "https://www.techno-science.net/fr/definitions/cite-de-carcassonne",
     "text": "The inner enclosure takes over the ancient rampart, reworked around 1280."
    }
   ]
  },
  {
   "id": "comtal",
   "when": "12th century",
   "title": "The Trencavel castle",
   "text": "The Trencavel viscounts build the count's castle against the western wall. The town grows denser around its basilica.",
   "source": "https://www.tourisme-occitanie.com/les-sites-classes-unesco/cite-medievale-de-carcassonne",
   "moments": [
    {
     "at": 0.55,
     "tag": "Technique",
     "title": "A fortress within the fortress",
     "anchor": [
      -79,
      20,
      0
     ],
     "source": "https://www.techno-science.net/fr/definitions/cite-de-carcassonne",
     "text": "The count's castle is a true fortress inside the Cité, with its own walls and towers."
    }
   ]
  },
  {
   "id": "royal",
   "when": "13th century",
   "title": "The kings double the wall",
   "text": "Now a royal stronghold, the Cité gets a second wall. The inner wall is raised and the Narbonne Gate takes its present form at the end of the century.",
   "source": "https://whc.unesco.org/document/153233",
   "moments": [
    {
     "at": 0.5,
     "tag": "Technique",
     "title": "The lists",
     "anchor": [
      0,
      4,
      160
     ],
     "source": "https://www.cityzeum.com/remparts-de-la-cite",
     "text": "Between the two walls lie the lists. Whoever crosses the first wall is caught in the open at the foot of the second."
    },
    {
     "at": 0.9,
     "tag": "Monument",
     "title": "The Narbonne Gate",
     "anchor": [
      93,
      22,
      0
     ],
     "source": "https://ryo.co/fr/destinations/france/lieux/porte-narbonnaise/",
     "text": "Two great towers frame the main entrance, guarded by a barbican. It takes its present form at the end of the 13th century."
    }
   ]
  },
  {
   "id": "declin",
   "when": "17th – 18th century",
   "title": "Abandonment",
   "text": "The border moves away and the Cité loses its military role. The tops of walls and towers fall into ruin.",
   "source": "https://fr.wikipedia.org/wiki/Cit%C3%A9_de_Carcassonne"
  },
  {
   "id": "restauration",
   "when": "1853 – late 19th century",
   "title": "Viollet-le-Duc restores",
   "text": "Viollet-le-Duc rebuilds the walls and caps the towers with pointed slate roofs, a choice still debated. His successors finish the work.",
   "source": "https://www.techno-science.net/fr/definitions/cite-de-carcassonne",
   "moments": [
    {
     "at": 0.08,
     "tag": "Anecdote",
     "title": "Saved from demolition",
     "anchor": [
      -60,
      10,
      -120
     ],
     "source": "https://en.wikipedia.org/wiki/Cit%C3%A9_de_Carcassonne",
     "text": "In 1849 a decree plans to demolish the fortifications. The mayor Jean-Pierre Cros-Mayrevieille and Prosper Mérimée lead the campaign that saves them."
    },
    {
     "at": 0.55,
     "tag": "Controversy",
     "title": "Roofs from the north",
     "anchor": [
      0,
      24,
      143
     ],
     "source": "https://www.herodote.net/Une_vie_au_service_du_patrimoine_architectural-synthese-2073.php",
     "text": "Viollet-le-Duc caps the towers with slate cones, as in northern France. His critics point out that here, roofs were tiled and gently sloped."
    }
   ]
  },
